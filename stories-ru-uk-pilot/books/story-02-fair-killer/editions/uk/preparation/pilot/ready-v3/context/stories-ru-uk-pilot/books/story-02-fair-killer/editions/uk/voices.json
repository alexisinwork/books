  "entries": [
    {
      "id": "story-02-fair-killer-v01",
      "character": "Рассказчик",
      "description": "Свободно перемещается между настоящей сценой, детством Лайта и биографией Хаста; даёт пояснения, легенду и моральные оценки. Легенда имеет явную оговорку, а позиция героя в реплике не становится заключением рассказчика.",
      "status": "proposed",
      "evidence_kind": "text_observation",
      "author_decision": null,
      "anchors": [
        {
          "path": "stories-ru-uk-pilot/books/story-02-fair-killer/sources/originals/Справедливый убийца.docx",
          "sha256": "3d672a54c9a69e9143dfbd15214a10f8930b8fc1dd1bbc5a739441f56466baa0",
          "format": "docx",
          "status": "author_selected",
          "authority": "Автор явно выбрал этот файл из Desktop/Astra для полного пилотного перевода RU→UK 2026-09-14; это источник текущего рассказа, не окончательный межтомный канон.",
          "role": "master_inventory",
          "language": "ru",
          "chapter": 0,
          "p": 46,
          "source_id": "story-02-fair-killer-c000-p000046",
          "quote": "Никто не знает наверняка, была ли эта история правдива, но большинство верит именно в нее.",
          "quote_ru": "Никто не знает наверняка, была ли эта история правдива, но большинство верит именно в нее.",
          "paragraph_sha256": "24874c9f73f14a98593dd6981ac33c04ea93a08a3e707c5b829c56d625cc5b07"
        }
      ]
    },
    {
      "id": "story-02-fair-killer-v02",
      "character": "Лайт / Эсквайр",
      "description": "Учтивый контролирующий голос, методичное ведение допроса, длинные афористические рассуждения. Речь способна перейти в крик о зависти, затем вернуться к холодности. Самооправдания и признания не сглаживать в единый объективный трактат.",
      "status": "proposed",
      "evidence_kind": "text_observation",
      "author_decision": null,
      "anchors": [
        {
          "path": "stories-ru-uk-pilot/books/story-02-fair-killer/sources/originals/Справедливый убийца.docx",
          "sha256": "3d672a54c9a69e9143dfbd15214a10f8930b8fc1dd1bbc5a739441f56466baa0",
          "format": "docx",
          "status": "author_selected",
          "authority": "Автор явно выбрал этот файл из Desktop/Astra для полного пилотного перевода RU→UK 2026-09-14; это источник текущего рассказа, не окончательный межтомный канон.",
          "role": "master_inventory",
          "language": "ru",
          "chapter": 0,
          "p": 149,
          "source_id": "story-02-fair-killer-c000-p000149",
          "quote": "Я задаю тон разговора, и только от нашего общения зависит то, что будет дальше.",
          "quote_ru": "Я задаю тон разговора, и только от нашего общения зависит то, что будет дальше.",
          "paragraph_sha256": "16f9eb5d4df5544dc9dbc8563d118ffa272d3b4b16fb45d1eb160eea7459ddf3"
        }
      ]
    },
    {
      "id": "story-02-fair-killer-v03",
      "character": "Джулия / взрослая Кристина",
      "description": "Изначально спокойная собранность; память возвращает уязвимость ребёнка; месть переводит речь в приказы, восклицания и ругань. В споре пользуется чёрно-белыми формулами и сама замечает противоречие Лайта.",
      "status": "proposed",
      "evidence_kind": "text_observation",
      "author_decision": null,
      "anchors": [
        {
          "path": "stories-ru-uk-pilot/books/story-02-fair-killer/sources/originals/Справедливый убийца.docx",
