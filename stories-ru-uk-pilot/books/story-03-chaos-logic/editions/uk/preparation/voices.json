    {
      "id": "story-03-chaos-logic-v03",
      "character": "Ника Пастернак",
      "description": "Командные реплики и требования субординации; при аварии конкретные задачи, затем забота о Вольфе и здоровье Чарльза. Сухой образ дан через раздражение Гарри и корректируется её поведением.",
      "status": "proposed",
      "evidence_kind": "text_observation",
