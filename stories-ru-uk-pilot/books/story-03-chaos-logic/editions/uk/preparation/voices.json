  "entries": [
    {
      "id": "story-03-chaos-logic-v01",
      "character": "Гарри Арчер, рассказчик",
      "description": "Свободные ассоциации, гиперболы, кинематографические и телесные шутки; любит брата под раздражением. В расследовании способен последовательно рассуждать, в финале отказывается от игровой бравады. Его гендерные и социальные оценки оставлять субъективными.",
      "status": "proposed",
      "evidence_kind": "text_observation",
      "author_decision": null,
      "anchors": [
        {
          "path": "stories-ru-uk-pilot/books/story-03-chaos-logic/sources/originals/Логика хаоса.docx",
