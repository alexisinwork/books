  "state_quotes": [
    {
      "scene": "B03-CH01-SC01",
      "quote": "Ти просив без коробок.",
      "exact_in_chapter": true
    },
    {
      "scene": "B03-CH01-SC01",
      "quote": "Я не показав Тарасові жодного документа.",
      "exact_in_chapter": true
    },
    {
      "scene": "B03-CH01-SC02",
      "quote": "Файл покажу сам. Копію поки не надсилаю",
      "exact_in_chapter": true
    },
    {
      "scene": "B03-CH01-SC02",
      "quote": "Може, це зовсім інша річ.",
      "exact_in_chapter": true
    },
    {
      "scene": "B03-CH02-SC01",
      "quote": "Джерело сценарного рішення: Predictariat",
      "exact_in_chapter": true
    },
    {
      "scene": "B03-CH02-SC01",
      "quote": "Саме їх і хочу розрізнити",
      "exact_in_chapter": true
    },
    {
      "scene": "B03-CH03-SC01",
      "quote": "Той день був мій",
      "exact_in_chapter": true
    },
    {
      "scene": "B03-CH03-SC01",
      "quote": "Тут не написано, чому саме ти пішов",
      "exact_in_chapter": true
    },
    {
      "scene": "B03-CH03-SC02",
      "quote": "Пообіцяти, що знайду для тебе непередбачений день, не можу.",
      "exact_in_chapter": true
    },
    {
      "scene": "B03-CH03-SC02",
      "quote": "Тут я можу бути тільки поруч із тобою.",
      "exact_in_chapter": true
    },
    {
      "scene": "B03-CH04-SC01",
      "quote": "Нижче стояв L1+A.",
      "exact_in_chapter": true
    },
    {
      "scene": "B03-CH04-SC01",
      "quote": "Наш приватний вибір не був єдиним підготовленим варіантом",
      "exact_in_chapter": true
    },
    {
      "scene": "B03-CH05-SC01",
      "quote": "Перераховуємо наступне. Старе не стає від цього правильним.",
      "exact_in_chapter": true
    },
    {
      "scene": "B03-CH05-SC01",
      "quote": "Це не нейтральне спостереження. Я не називатиму його нейтральним.",
      "exact_in_chapter": true
    },
    {
      "scene": "B03-CH05-SC02",
      "quote": "Для старого самовивозу треба було звести записи кількох сервісів.",
      "exact_in_chapter": true
    },
    {
      "scene": "B03-CH05-SC02",
      "quote": "Поки не треба",
      "exact_in_chapter": true
    },
    {
      "scene": "B03-CH06-SC01",
      "quote": "До приймального віконця ми дійшли о десятій двадцять п’ять.",
      "exact_in_chapter": true
    },
    {
      "scene": "B03-CH06-SC01",
      "quote": "Я вписав фактичні значення поруч. Не поверх.",
      "exact_in_chapter": true
    },
    {
      "scene": "B03-CH07-SC01",
      "quote": "Тоді мій пакет можна просто донести.",
      "exact_in_chapter": true
    },
    {
      "scene": "B03-CH07-SC01",
      "quote": "Нова версія була молодша за нашу доставку рами.",
      "exact_in_chapter": true
    },
    {
      "scene": "B03-CH08-SC01",
      "quote": "Я вже взяв цей у сусідньому дворі.",
      "exact_in_chapter": true
    },
    {
      "scene": "B03-CH08-SC01",
      "quote": "Я й не бачив того самого.",
      "exact_in_chapter": true
    },
    {
      "scene": "B03-CH09-SC01",
      "quote": "До п’ятниці, до шостої вечора.",
      "exact_in_chapter": true
    },
    {
      "scene": "B03-CH09-SC01",
      "quote": "На суботу є один пробний",
      "exact_in_chapter": true
    },
    {
      "scene": "B03-CH10-SC01",
      "quote": "Я це кажу про себе.",
      "exact_in_chapter": true
    },
    {
      "scene": "B03-CH10-SC01",
      "quote": "Хотів, щоб вони знали: якщо щось не так, писати мені.",
      "exact_in_chapter": true
    },
    {
      "scene": "B03-CH11-SC01",
      "quote": "За краєм екрана ховалося поле статусу. «Скасовано».",
      "exact_in_chapter": true
    },
    {
      "scene": "B03-CH11-SC01",
      "quote": "Я не кажу, що не було. Кажу, не бачив.",
      "exact_in_chapter": true
    },
    {
      "scene": "B03-CH11-SC02",
      "quote": "Ти хочеш спитати про час чи звинуватити його?",
      "exact_in_chapter": true
    },
    {
      "scene": "B03-CH11-SC02",
      "quote": "Тоді поки не знатимемо.",
      "exact_in_chapter": true
    },
    {
      "scene": "B03-CH12-SC01",
      "quote": "Запис можу. Увесь календар не дам.",
      "exact_in_chapter": true
    },
    {
      "scene": "B03-CH12-SC01",
      "quote": "Забрав би насадку й поїхав.",
      "exact_in_chapter": true
    },
    {
      "scene": "B03-CH13-SC01",
      "quote": "Ці дані не доводять, що без рекомендацій із вами обов’язково сталося б щось гірше.",
      "exact_in_chapter": true
    },
    {
      "scene": "B03-CH13-SC01",
      "quote": "Ваші цифри не кажуть, скільки такого впливу можна дозволити заради нижчого ризику.",
      "exact_in_chapter": true
    },
    {
      "scene": "B03-CH14-SC01",
      "quote": "Я підтвердив",
      "exact_in_chapter": true
    },
    {
      "scene": "B03-CH14-SC01",
      "quote": "Час видавання був сьогоднішній; час створення — старий.",
      "exact_in_chapter": true
    },
    {
      "scene": "B03-CH14-SC02",
      "quote": "Не переплутали.",
      "exact_in_chapter": true
    },
    {
      "scene": "B03-CH14-SC02",
      "quote": "Вони весь час починають заново",
      "exact_in_chapter": true
    },
    {
      "scene": "B03-CH15-SC01",
      "quote": "Зниження навантаження через делегування поточних рішень.",
      "exact_in_chapter": true
    },
    {
      "scene": "B03-CH15-SC01",
      "quote": "Читання є умовою, яку модель бачить. Не наказом.",
      "exact_in_chapter": true
    },
    {
      "scene": "B03-CH16-SC01",
      "quote": "Треба ще занести й поставити. Ми домовились удвох.",
      "exact_in_chapter": true
    },
    {
      "scene": "B03-CH16-SC01",
      "quote": "Не приходь чекати під дверима, добре?",
      "exact_in_chapter": true
    },
    {
      "scene": "B03-CH16-SC02",
      "quote": "Мені вистачить.",
      "exact_in_chapter": true
    },
    {
      "scene": "B03-CH16-SC02",
      "quote": "Хочу завтра прожити день із меншим числом рішень.",
      "exact_in_chapter": true
    },
    {
      "scene": "B03-CH17-SC01",
      "quote": "На картці з’явився строк: середа, 07:00–22:00.",
      "exact_in_chapter": true
    },
    {
      "scene": "B03-CH17-SC01",
      "quote": "Ніхто не зробив цього раніше за мене.",
      "exact_in_chapter": true
    },
    {
      "scene": "B03-CH18-SC01",
      "quote": "Не виправляйте навмання.",
      "exact_in_chapter": true
    },
    {
      "scene": "B03-CH18-SC01",
      "quote": "Я перевірив надходження й надіслав підтвердження сам.",
      "exact_in_chapter": true
    },
    {
      "scene": "B03-CH18-SC02",
      "quote": "Потім я задрімав.",
      "exact_in_chapter": true
    },
    {
      "scene": "B03-CH18-SC02",
      "quote": "Не став шукати кращої.",
      "exact_in_chapter": true
    },
    {
      "scene": "B03-CH19-SC01",
      "quote": "Не зараз, подумав я.",
      "exact_in_chapter": true
    },
    {
      "scene": "B03-CH19-SC01",
      "quote": "Я сам двічі побачив можливість відхилитися й сам лишив її такою.",
      "exact_in_chapter": true
    },
    {
      "scene": "B03-CH20-SC01",
      "quote": "На завтра не продовжувати. Збереженого списку досить",
      "exact_in_chapter": true
    },
    {
      "scene": "B03-CH20-SC01",
      "quote": "О двадцять другій статус змінився на завершений.",
      "exact_in_chapter": true
    },
    {
      "scene": "B03-CH21-SC01",
      "quote": "Виконана дія підняла їх у його переліку доступних місць.",
      "exact_in_chapter": true
    },
    {
      "scene": "B03-CH21-SC01",
      "quote": "Не треба зараз.",
      "exact_in_chapter": true
    },
    {
      "scene": "B03-CH21-SC02",
      "quote": "Двір працював і раніше, і пізніше.",
      "exact_in_chapter": true
    },
    {
      "scene": "B03-CH21-SC02",
      "quote": "У вашому файлі я не розбираюся.",
      "exact_in_chapter": true
    },
    {
      "scene": "B03-CH22-SC01",
      "quote": "Скасую суботу.",
      "exact_in_chapter": true
    },
    {
      "scene": "B03-CH22-SC01",
      "quote": "Від полудня четверга до суботньої зміни лишалося менше двох діб.",
      "exact_in_chapter": true
    },
    {
      "scene": "B03-CH23-SC01",
      "quote": "До перевалки. Далі пішки.",
      "exact_in_chapter": true
    },
    {
      "scene": "B03-CH23-SC01",
      "quote": "Другого квитка ми не купили.",
      "exact_in_chapter": true
    },
    {
      "scene": "B03-CH24-SC01",
      "quote": "Не до кінця.",
      "exact_in_chapter": true
    },
    {
      "scene": "B03-CH24-SC01",
      "quote": "Не оголосив, що назавжди відмовився від дальньої дороги.",
      "exact_in_chapter": true
    },
    {
      "scene": "B03-CH25-SC01",
      "quote": "Сьогодні більше нікуди.",
      "exact_in_chapter": true
    },
    {
      "scene": "B03-CH25-SC01",
      "quote": "Ніч за його дверима не була моєю роботою.",
      "exact_in_chapter": true
    },
    {
      "scene": "B03-CH26-SC01",
      "quote": "У квитанції стояла п’ятниця, восьма ранку.",
      "exact_in_chapter": true
    },
    {
      "scene": "B03-CH26-SC01",
      "quote": "Дайте трохи часу.",
      "exact_in_chapter": true
    },
    {
      "scene": "B03-CH27-SC01",
      "quote": "Мені досить,",
      "exact_in_chapter": true
    },
    {
      "scene": "B03-CH27-SC01",
      "quote": "Я не знаю, що було далі",
      "exact_in_chapter": true
    },
    {
      "scene": "B03-CH28-SC01",
      "quote": "Хочу ще раз почути умови рейсу",
      "exact_in_chapter": true
    },
    {
      "scene": "B03-CH28-SC01",
      "quote": "Хочу пройти його. І заробити.",
      "exact_in_chapter": true
    },
    {
      "scene": "B03-CH29-SC01",
      "quote": "Обхід. Знову.",
      "exact_in_chapter": true
    },
    {
      "scene": "B03-CH29-SC01",
      "quote": "— Сумку потримай, — сказав він. — Я затягну ремінь.",
      "exact_in_chapter": true
    },
    {
      "scene": "B03-CH29-SC02",
      "quote": "Хочу завершити звернення.",
      "exact_in_chapter": true
    },
    {
      "scene": "B03-CH29-SC02",
      "quote": "Цього разу я не йшов слідом.",
      "exact_in_chapter": true
    },
    {
      "scene": "B03-CH30-SC01",
      "quote": "Знайомий тип. Незнайома тріщина.",
      "exact_in_chapter": true
    },
    {
      "scene": "B03-CH30-SC01",
      "quote": "Частина мого підготовленого речення лишилася при мені.",
      "exact_in_chapter": true
    },
    {
      "scene": "B03-CH31-SC01",
      "quote": "Майбутніх розвилок у пакеті не було; я перевірив склад до відкриття.",
      "exact_in_chapter": true
    },
    {
      "scene": "B03-CH31-SC01",
      "quote": "Два рядки не стали дослідом, у якому ми прибрали всі інші причини.",
      "exact_in_chapter": true
    },
    {
      "scene": "B03-CH32-SC01",
      "quote": "Це не інша назва впевненості прогнозу",
      "exact_in_chapter": true
    },
    {
      "scene": "B03-CH32-SC01",
      "quote": "Він пішов швидко, але не тікав.",
      "exact_in_chapter": true
    }
  ],
