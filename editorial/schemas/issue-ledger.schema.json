{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/alexisinwork/books/editorial/schemas/issue-ledger.schema.json",
  "title": "Editorial ensemble issue ledger",
  "type": "object",
  "required": ["schema_version", "run_id", "project_id", "book_id", "source_sha256", "status", "items"],
  "properties": {
    "schema_version": {"const": 1},
    "run_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
    "project_id": {"type": "string", "minLength": 1},
    "book_id": {"type": "string", "minLength": 1},
    "source_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "status": {"enum": ["collecting", "reconciled", "author_decided", "implemented", "verified"]},
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "origin_reports",
          "category",
          "severity",
          "certainty",
          "locations",
          "observation",
          "reader_effect",
          "evidence",
          "proposed_actions",
          "dependencies",
          "author_decision",
          "implementation",
          "verification"
        ],
        "properties": {
          "id": {"type": "string", "pattern": "^ENS-[0-9]{3,}$"},
          "origin_reports": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"enum": ["astra", "claude", "gemini_flash", "gemini"]}
          },
          "category": {
            "enum": [
              "structure",
              "causality",
              "character",
              "canon",
              "knowledge",
              "continuity",
              "pacing",
              "scene",
              "voice",
              "prose",
              "clarity",
              "promise",
              "ending",
              "format",
              "other"
            ]
          },
          "severity": {"enum": ["critical", "major", "moderate", "minor"]},
          "certainty": {"enum": ["confirmed_conflict", "strong_inference", "reader_reaction", "hypothesis", "taste"]},
          "locations": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["anchor"],
              "properties": {
                "chapter": {"type": ["integer", "string", "null"]},
                "anchor": {"type": "string", "minLength": 1},
                "quote": {"type": ["string", "null"]}
              }
            }
          },
          "observation": {"type": "string", "minLength": 1},
          "reader_effect": {"type": "string", "minLength": 1},
          "evidence": {"type": "string", "minLength": 1},
          "agreement": {"enum": ["single", "convergent", "conflicted"]},
          "proposed_actions": {"type": "array", "items": {"type": "string"}},
          "dependencies": {"type": "array", "items": {"type": "string"}},
          "author_decision": {
            "type": "object",
            "required": ["status", "basis"],
            "properties": {
              "status": {"enum": ["pending", "accepted", "rejected", "modified", "deferred"]},
              "basis": {"type": ["string", "null"]},
              "decided_at": {"type": ["string", "null"]}
            }
          },
          "implementation": {
            "type": "object",
            "required": ["status", "targets"],
            "properties": {
              "status": {"enum": ["not_started", "not_applicable", "applied", "partial"]},
              "targets": {"type": "array", "items": {"type": "string"}},
              "revision_sha256": {"type": ["string", "null"]}
            }
          },
          "verification": {
            "type": "object",
            "required": ["status", "evidence"],
            "properties": {
                           "status": {"enum": ["not_run", "passed", "failed", "stale"]},
              "evidence": {"type": ["string", "null"]}
            }
          }
        }
      }
    }
  }
}
