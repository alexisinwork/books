          "source_sha256": "02aef0016f9664531be1115d95b78eb0c255e52fd09f550b2c7f84f2c9dce4e8",
          "chapter": 55,
          "p": 6835,
          "quote": "— Я ещё здесь.",
          "verification_status": "exact_match",
          "original_chapter_2026_09_13": 57
        }
      ]
